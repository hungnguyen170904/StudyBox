PORT=5000

# Database
DATABASE_URL=postgres://user:password@hostname:5432/db_name?sslmode=require
# Hoặc dùng từng biến riêng:
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studybox

# Redis
REDIS_URL=rediss://default:password@hostname:port

# Auth
JWT_SECRET=your_super_secret_key_here_at_least_32_chars

# CORS — liệt kê origin frontend, phân cách bằng dấu phẩy
# Development: CLIENT_URL=http://localhost:5173
# Production:  CLIENT_URL=https://studybox.app,https://www.studybox.app
CLIENT_URL=http://localhost:5173
